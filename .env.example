# Optional key for full wallet books. Leave blank for public leaderboard + alerts.
BUON_API_KEY=

LEADER_WINDOW=24h
LEADER_LIMIT=25
MIN_OVERLAP=3
MIN_HOLDING_USD=50
MIN_ALERT_USD=250
SNAPSHOT_EVERY=90

SNATCH_RISK_PROVIDER=placeholder
# External provider form: module:your_package.your_module:YourRiskProvider
SNATCH_RISK_ENABLED=true
SNATCH_RISK_STRICT_UNKNOWN=false
SNATCH_MIN_TOKEN_AGE_MINUTES=10
SNATCH_REQUIRE_LIQUIDITY_LOCK=false
SNATCH_MIN_LIQUIDITY_LOCK_PCT=70
SNATCH_BLOCK_HONEYPOT=true

SNATCH_EVENT_MIN_USD=220
SNATCH_FAST_MIN_BUY_COUNT=2
SNATCH_FAST_MIN_UNIQUE_BUYERS=2
SNATCH_FAST_MIN_WEIGHTED_BUYERS=0.22
SNATCH_FAST_MIN_FLOW_RATIO=0.58
SNATCH_MOMENTUM_MIN_SCORE=0.40
SNATCH_TP1_PCT=2.5
SNATCH_TP1_FRACTION=0.60
SNATCH_TP2_PCT=4.0
SNATCH_EMERGENCY_STOP_PCT=1.5

# Cash pile DLN spends from: base | arbitrum | bsc | ethereum | solana
USDC_HUB=base
EVM_ADDRESS=
SOL_ADDRESS=
